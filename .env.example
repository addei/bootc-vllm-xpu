# bootc-vllm-xpu project configuration
# Copy to .env and customize. Sourced by all scripts automatically.
# CLI flags always override these values.

# ─── Shared ───────────────────────────────────────────────────────────────────
IMAGE_NAME="bootc-vllm-xpu"

# Registry hostname (leave empty for local-only builds)
REGISTRY=""

# ─── build.sh ─────────────────────────────────────────────────────────────────
PLATFORM="linux/amd64"

# intel-arc-pro-b70-inference-cookbook ref for the MTP patches (pin to a commit SHA)
COOKBOOK_REF="master"

# ─── create-disk-image.sh ─────────────────────────────────────────────────────
# Disk image type: qcow2 (QEMU testing), raw (VM/disk), or iso (bare-metal)
IMAGE_TYPE="qcow2"

# CONFIG_FILE="./config.toml"
# OUTPUT_DIR="./output"
