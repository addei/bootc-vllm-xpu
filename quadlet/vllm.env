# vLLM runtime configuration (edit /etc/vllm/vllm.env on the deployed host).
# Read by podman --env-file: values are literal, do NOT quote them.
# Own settings use SERVE_*: vLLM warns about any unknown VLLM_* variable.

# Model directory under /var/lib/vllm/models (mounted at /models in the container).
SERVE_MODEL=/models/Qwen3.8-27B-GPTQ-Int4-sym-G128-MTP-BF16
SERVE_MODEL_NAME=qwen38

# MTP speculative decoding; leave empty to disable.
SERVE_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":4}
B70_MTP_BF16_DRAFT=1

# Apply the cookbook MTP patches before starting (1/0).
SERVE_APPLY_PATCHES=1

# Prefix caching must stay off with MTP: the combination silently corrupts output.
SERVE_ARGS=--quantization gptq --dtype float16 --max-model-len 100000 --gpu-memory-utilization 0.88 --kv-cache-dtype fp8 --max-num-seqs 1 --max-num-batched-tokens 8192 --no-enable-prefix-caching --language-model-only --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3

# Uncomment if kernel JIT fails with UR_RESULT_ERROR_OUT_OF_RESOURCES.
#TORCHINDUCTOR_COMPILE_THREADS=1

# Set to require "Authorization: Bearer <key>" on the API.
VLLM_API_KEY=
